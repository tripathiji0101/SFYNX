# SFYNX Backend Environment Variables
# Copy to .env and fill in values

# Application
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Database (Phase 4+)
# DATABASE_URL=postgresql+asyncpg://sfynx:sfynx@localhost:5432/sfynx

# Allowed scan targets (comma-separated, used in addition to built-in safe targets)
# SFYNX_ALLOWED_TARGETS=localhost,127.0.0.1

# Scanner timeouts (seconds)
SFYNX_HTTPX_TIMEOUT=120
SFYNX_NUCLEI_TIMEOUT=300

# Scanner binary paths (defaults to PATH lookup)
# SFYNX_HTTPX_BIN=httpx
# SFYNX_NUCLEI_BIN=nuclei

# LLM (Phase 5+)
# SFYNX_LLM_API_KEY=
# SFYNX_LLM_MODEL=
# SFYNX_LLM_BASE_URL=
